# токен от @BotFather
BOT_TOKEN=
# твой chat_id: отправь боту /start, он его покажет
CHAT_ID=
# PostgreSQL: postgresql://пользователь:пароль@хост:порт/база
# на Vercel — строка подключения облачной базы (например, Neon), с ?sslmode=require
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/newsbot

# Vercel: любые длинные случайные строки (например, `openssl rand -hex 32`)
#   CRON_SECRET    — Vercel передаёт его в cron-запросах, чужие запросы отклоняются
#   WEBHOOK_SECRET — Telegram передаёт его в webhook-запросах
CRON_SECRET=
WEBHOOK_SECRET=

# Перевод: none | mymemory | azure | google | deepl
#   mymemory — без ключа; с TRANSLATOR_EMAIL лимит 50 тыс. символов в день вместо 5 тыс.
#   azure    — Microsoft Translator, бесплатно 2 млн символов в месяц; нужны KEY и REGION
#   google   — Google Cloud Translation API, ключ API
#   deepl    — DeepL API, ключ (бесплатные ключи заканчиваются на :fx)
TRANSLATOR=mymemory
TRANSLATOR_KEY=
TRANSLATOR_REGION=
TRANSLATOR_EMAIL=
